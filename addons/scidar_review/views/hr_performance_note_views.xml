<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_performance_note_tree_view" model="ir.ui.view">
            <field name="name">hr.performance.note.tree</field>
            <field name="model">hr.performance.note</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="sequence"/>
                </tree>
            </field>
        </record>
        <record id="hr_performance_note_action" model="ir.actions.act_window">
            <field name="name">Assessment Notes</field>
            <field name="res_model">hr.performance.note</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No assessment notes yet.</p>
                <p>Create a new note by clicking on "Create".</p>
            </field>
        </record>
    </data>
</odoo>
