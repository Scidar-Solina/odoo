<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_performance_view_form" model="ir.ui.view">
        <field name="name">hr.performance.form</field>
        <field name="model">hr.performance</field>
        <field name="arch" type="xml">
            <form string="Employee Appraisal" class="o_appraisal_form">
                <header>
                    <button name="action_generate_part_a_lines" type="object" string="Generate Lines"/>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_done" string="Mark as Done" type="object" class="oe_highlight" invisible="state != 'pending'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'pending'"/>
                    <button name="action_back" string="Reopen" type="object" invisible="state != 'done' and state != 'cancel'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="employee_id" widget="many2one_avatar_employee"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="manager_ids" widget="many2many_avatar_employee"/>
                            <field name="date_close"/>
                        </group>
                        <group>
                            <field name="overall_reviewer_rating"/>
                            <field name="first_supervisor_comments"/>
                            <field name="second_supervisor_comments"/>
                            <field name="principals_comments"/>
                        </group>
                        <group>
                            <field name="company_id"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Problem Solving">
                            <field name="rating_ids">
                                <tree editable="bottom">
                                    <field name="description"/>
                                    <field name="objectives" style="white-space: normal; word-break: break-word;"/>
                                    <field name="employee_rating"/>
                                    <field name="reviewer_rating"/>
                                    <field name="comments"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Communication (oral and written)">
                            <field name="comms_skills_id">
                                <tree editable="bottom">
                                    <field name="descriptions"/>
                                    <field name="objectivesc" style="white-space: normal; word-break: break-word;"/>
                                    <field name="employee_ratingc"/>
                                    <field name="reviewer_ratingc"/>
                                    <field name="commentsc"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Computer Skills">
                            <field name="computer_skills_id">
                                <tree editable="bottom">
                                    <field name="descriptionscom"/>
                                    <field name="objectivescom" style="white-space: normal; word-break: break-word;"/>
                                    <field name="employee_ratingcom"/>
                                    <field name="reviewer_ratingcom"/>
                                    <field name="commentscom"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Productivity and Work Output">
                            <field name="work_skills_id">
                                <tree editable="bottom">
                                    <field name="descriptionspro"/>
                                    <field name="objectivespro" style="white-space: normal; word-break: break-word;"/>
                                    <field name="employee_ratingpro"/>
                                    <field name="reviewer_ratingpro"/>
                                    <field name="commentspro"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Professionalism and Personal Leadership">
                            <field name="prof_skills_id">
                                <tree editable="bottom">
                                    <field name="descriptionsprof"/>
                                    <field name="objectivesprof" style="white-space: normal; word-break: break-word;"/>
                                    <field name="employee_ratingprof"/>
                                    <field name="reviewer_ratingprof"/>
                                    <field name="commentsprof"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Team Leadership">
                            <field name="team_skills_id">
                                <tree editable="bottom">
                                    <field name="descriptionsTeam"/>
                                    <field name="objectivesTeam" style="white-space: normal; word-break: break-word;"/>
                                    <field name="employee_rating_team"/>
                                    <field name="reviewer_rating_team"/>
                                    <field name="comments_team"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Firm Leadership">
                            <field name="firm_skills_ids">
                                <tree editable="bottom">
                                    <field name="descriptionsFirm"/>
                                    <field name="objectivesFirm"/>
                                    <field name="employee_rating_firm"/>
                                    <field name="reviewer_rating_firm"/>
                                    <field name="comments_firm"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" groups="base.group_user"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="hr_performance_view_tree" model="ir.ui.view">
        <field name="name">hr.performance.tree</field>
        <field name="model">hr.performance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id" widget="many2one_avatar_user"/>
                <field name="date_close" widget="remaining_days"/>
                <field name="state" widget="badge" decoration-info="state in ('new','pending')" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="hr_performance_view_kanban" model="ir.ui.view">
        <field name="name">hr.performance.kanban</field>
        <field name="model">hr.performance</field>
        <field name="arch" type="xml">
            <kanban quick_create="false" default_order="state desc, date_close" class="o_hr_employee_kanban">
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click o_kanban_card_appraisal">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="employee_id"/>
                                </strong>
                                <field name="date_close"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Actions -->
    <record id="hr_performance_action" model="ir.actions.act_window">
        <field name="name">Appraisals</field>
        <field name="res_model">hr.performance</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="hr_performance_action_goal" model="ir.actions.act_window">
        <field name="name">Employee Goals</field>
        <field name="res_model">hr.performance.goal</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>

    <record id="hr_performance_action_note" model="ir.actions.act_window">
        <field name="name">Assessment Notes</field>
        <field name="res_model">hr.performance.note</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="request_appraisal_action" model="ir.actions.act_window">
        <field name="name">Appraisal Requests</field>
        <field name="res_model">request.appraisal</field>
        <field name="view_mode">kanban,tree,form</field>
    </record>



    
</odoo>