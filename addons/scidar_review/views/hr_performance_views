<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_performance_form" model="ir.ui.view">
        <field name="name">hr.performance.form</field>
        <field name="model">hr.performance</field>
        <field name="arch" type="xml">
            <form string="Employee Appraisal">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="manager_ids"/>
                        <field name="date_close"/>
                        <field name="state" widget="statusbar"/>
                    </group>
                    <notebook>
                        <page string="Performance Ratings">
                            <field name="rating_ids">
                                <tree editable="bottom">
                                    <field name="competency"/>
                                    <field name="employee_rating"/>
                                    <field name="reviewer_rating"/>
                                    <field name="comments"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Goals & Development">
                            <field name="goal_ids">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="deadline"/>
                                    <field name="state"/>
                                    <field name="progress"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_performance_tree" model="ir.ui.view">
        <field name="name">hr.performance.tree</field>
        <field name="model">hr.performance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="employee_id"/>
                <field name="date_close"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="view_hr_performance_kanban" model="ir.ui.view">
        <field name="name">hr.performance.kanban</field>
        <field name="model">hr.performance</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <field name="employee_id"/>
                            <field name="date_close"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
