<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_hr_performance_user" model="res.groups">
        <field name="name">HR Performance User</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_performance_manager" model="res.groups">
        <field name="name">HR Performance Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_performance_user'))]"/>
    </record>

    <!-- Model Access Rights -->
    <record id="access_hr_performance_user" model="ir.model.access">
        <field name="name">HR Performance - User Access</field>
        <field name="model_id" ref="model_hr_performance"/>
        <field name="group_id" ref="group_hr_performance_user"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="access_hr_performance_manager" model="ir.model.access">
        <field name="name">HR Performance - Manager Access</field>
        <field name="model_id" ref="model_hr_performance"/>
        <field name="group_id" ref="group_hr_performance_manager"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
