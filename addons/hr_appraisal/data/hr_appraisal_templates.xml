<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="hr_appraisal_employee_feedback">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>SCIDaR Employee Performance Review</h2>
                    <p><strong>Date of Review:</strong> <t t-esc="object.review_date"/></p>
                    <p><strong>Employee Name:</strong> <t t-esc="object.employee_id.name"/></p>
                    <p><strong>Current Position:</strong> <t t-esc="object.employee_id.job_id.name"/></p>
                    
                    <h3>Self-Assessment</h3>
                    <h4>Achievements Since Last Review</h4>
                    <p><t t-esc="object.self_achievements"/></p>
                    
                    <h4>Challenges Faced</h4>
                    <p><t t-esc="object.self_challenges"/></p>
                    
                    <h4>Areas for Improvement</h4>
                    <p><t t-esc="object.self_improvement"/></p>
                    
                    <h3>Future Goals</h3>
                    <h4>Short-Term Goals (&lt; 6 months)</h4>
                    <p><t t-esc="object.short_term_goals"/></p>
                    
                    <h4>Long-Term Goals (&gt; 6 months)</h4>
                    <p><t t-esc="object.long_term_goals"/></p>
                    
                    <h3>Manager's Feedback</h3>
                    <h4>Positive Achievements</h4>
                    <p><t t-esc="object.manager_achievements"/></p>
                    
                    <h4>Areas for Improvement</h4>
                    <p><t t-esc="object.manager_improvement"/></p>
                    
                    <h3>Performance Ratings</h3>
                    <table class="table table-bordered">
                        <tr>
                            <th>Category</th>
                            <th>Employee Rating</th>
                            <th>Manager Rating</th>
                        </tr>
                        <tr>
                            <td>Work Quality</td>
                            <td><t t-esc="object.work_quality_employee"/></td>
                            <td><t t-esc="object.work_quality_manager"/></td>
                        </tr>
                        <tr>
                            <td>Teamwork</td>
                            <td><t t-esc="object.teamwork_employee"/></td>
                            <td><t t-esc="object.teamwork_manager"/></td>
                        </tr>
                        <tr>
                            <td>Time Management</td>
                            <td><t t-esc="object.time_management_employee"/></td>
                            <td><t t-esc="object.time_management_manager"/></td>
                        </tr>
                    </table>
                    
                    <h3>Next Steps</h3>
                    <p><strong>Development Objectives:</strong> <t t-esc="object.development_objectives"/></p>
                    <p><strong>Capacity Development Needs:</strong> <t t-esc="object.capacity_needs"/></p>
                    
                    <h3>Final Comments</h3>
                    <p><strong>Employee Comments:</strong> <t t-esc="object.employee_comments"/></p>
                    <p><strong>Manager Comments:</strong> <t t-esc="object.manager_comments"/></p>
                    
                    <p><strong>Reviewer Signature:</strong> ______________________</p>
                    <p><strong>Employee Signature:</strong> ______________________</p>
                </div>
            </t>
        </t>
    </template>
</odoo>
